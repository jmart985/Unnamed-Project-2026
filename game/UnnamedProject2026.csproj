<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GodotProjectPath>$(MSBuildProjectDirectory)</GodotProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Simulation\Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="scripts\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\data\species.json" Link="data\species.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\relationship_events.json" Link="data\relationship_events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\trade_goods.json" Link="data\trade_goods.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\wildlife_regions.json" Link="data\wildlife_regions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
